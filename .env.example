# La demo móvil funciona sin variables de entorno ni servidor.
# No colocar secretos en EXPO_PUBLIC_*.
# Backend local multi-agente (no uses estos valores de ejemplo en producción).
# Genera cada token con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_TOKEN=
JARVIS_WEBHOOK_TOKEN=
JARVIS_DATABASE_PATH=backend/data/jarvis.db
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:4b

# IMAP es opcional. Las credenciales permanecen únicamente en el servidor local.
JARVIS_IMAP_HOST=
JARVIS_IMAP_PORT=993
JARVIS_IMAP_USERNAME=
JARVIS_IMAP_PASSWORD=
