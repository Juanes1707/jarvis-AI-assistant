{
  "name": "jarvis-student-command-center",
  "version": "0.2.0",
  "private": true,
  "overrides": {
    "react-dom": "19.2.3"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "ngrok:configure": "powershell.exe -NoProfile -File scripts/configure-ngrok.ps1",
    "start:tunnel": "powershell.exe -NoProfile -File scripts/start-tunnel.ps1",
    "test:tunnel": "node --test scripts/tunnel-utils.test.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "jest --runInBand",
    "export:native": "expo export --platform android --platform ios --output-dir artifacts/native-export"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "toqr": "^0.1.1",
    "typescript": "~6.0.3"
  }
}
